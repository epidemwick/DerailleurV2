# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# ADMIN_PASSWORD: Set this in Cloudflare Dashboard -> Workers & Pages -> Settings -> Variables and Secrets
# (or in local .env) to override the default SHA-256 passcode digest without storing plaintext in GitHub.
ADMIN_PASSWORD=""

# ADMIN_PASSWORD_HASH: Optional SHA-256 hex digest of the owner passcode.
ADMIN_PASSWORD_HASH="6ec6afafbd77a00d6ec99ca14208ba9bfadfbe35293048ca7d771821dadcff2d"
