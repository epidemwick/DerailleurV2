            updateNavAndTree();
            initBootScreen();
            cmdInputEl.focus();
        }

        function togglePower() {
            isPoweredOn = !isPoweredOn;
            if (!isPoweredOn) {
                if (editorOpen) closeEditor();
                crtOffOverlayEl.classList.add('active');
                hwPwrBtnEl.classList.add('off-state');
                statusLedEl.className = 'led-poweroff';
                document.getElementById('flip-mon').textContent = "--";
                document.getElementById('flip-day').textContent = "--";
                document.getElementById('flip-hr').textContent = "--";
                document.getElementById('flip-min').textContent = "--";
                try { window.close(); } catch (e) {}
            } else {
                crtOffOverlayEl.classList.remove('active');
                hwPwrBtnEl.classList.remove('off-state');
                setLedStatus(isLoggedIn ? 'online' : 'offline');
                updateFlipClock();
                playCrtPowerOnAnimation();
                cmdInputEl.focus();
            }
        }

        // =========================================================================
        // LED INDICATOR HELPER
        // =========================================================================
        function setLedStatus(state) {
            statusLedEl.className = '';
            if (state === 'offline') statusLedEl.classList.add('led-offline');
            else if (state === 'thinking') statusLedEl.classList.add('led-thinking');
            else if (state === 'online') statusLedEl.classList.add('led-online');
        }

        // =========================================================================
        // HARDWARE BUTTON DEPRESS ANIMATION & NAVIGATION
        // =========================================================================
        function pulseHardwareButton(btnId) {
            const btn = document.getElementById(btnId);
            if (!btn) return;
            btn.classList.add('depressed');
            setTimeout(() => btn.classList.remove('depressed'), 220);
        }

        const folderOrder = ["~", "~/about", "~/resume", "~/projects", "~/contact"];

        function hwNavigate(action) {
            if (!isLoggedIn || isAuthenticating || !isPoweredOn) return;
            if (action === 'rew') {
                pulseHardwareButton('btn-rew');
                if (editorOpen) {
                    closeEditor();
                } else {
                    const idx = folderOrder.indexOf(currentDir);
                    const prevIdx = idx <= 0 ? folderOrder.length - 1 : idx - 1;
                    quickCommand(`cd ${folderOrder[prevIdx]} && ls`);
                }
            } else if (action === 'ffwd') {
                pulseHardwareButton('btn-ffwd');
                if (editorOpen) closeEditor();
                const idx = folderOrder.indexOf(currentDir);
                const nextIdx = (idx + 1) % folderOrder.length;
                quickCommand(`cd ${folderOrder[nextIdx]} && ls`);
            } else if (action === 'play') {
                pulseHardwareButton('btn-play');
                if (editorOpen) {
                    closeEditor();
                } else {
                    const files = Object.keys(fileSystem[currentDir].files);
                    if (files.length > 0) {
                        quickCommand(`vim ${files[0]}`);
                    } else {
                        quickCommand('cd ~/about && vim about_me.txt');
                    }
                }
            }
        }

        // =========================================================================
        // SCROLL WHEEL ROTATION SYNC (Terminal + Vim + Drag/Wheel)
        // =========================================================================
        function rotateHardwareWheel(deltaY) {
            wheelRotation += deltaY * 0.35;
            scrollWheelEl.style.backgroundPosition = `0px ${wheelRotation}px`;
        }

        terminalEl.addEventListener('scroll', () => {
            rotateHardwareWheel(4);
        });

        editorContentEl.addEventListener('scroll', () => {
            rotateHardwareWheel(4);
        });

        window.addEventListener('wheel', (e) => {
            rotateHardwareWheel(e.deltaY * 0.25);
            if (editorOpen) {
                editorContentEl.scrollTop += e.deltaY * 0.5;
            }
        }, { passive: true });

        scrollWheelEl.addEventListener('wheel', (e) => {
            e.preventDefault();
            const target = editorOpen ? editorContentEl : terminalEl;
            target.scrollTop += e.deltaY;
            rotateHardwareWheel(e.deltaY * 0.4);
        });

        // =========================================================================
        // TOP NAVBAR & LAMBDA FILE TREE RENDERER
        // =========================================================================
        function updateNavAndTree() {
            const pathSuffix = currentDir === "~" ? "~" : currentDir;
            navUrlEl.textContent = `derailleur://epidos/${pathSuffix}`;

            // Update Top-Center Navbar Active Highlighting
            const navButtons = ['about', 'resume', 'projects', 'contact', 'clear'];
            navButtons.forEach(id => {
                const el = document.getElementById(`nav-btn-${id}`);
                if (el) el.classList.remove('active-nav');
            });

            if (currentDir === "~/about" || activeFile === "about_me.txt") {
                document.getElementById('nav-btn-about')?.classList.add('active-nav');
            } else if (currentDir === "~/resume" || ["experience.txt", "education.txt", "skills.txt"].includes(activeFile)) {
                document.getElementById('nav-btn-resume')?.classList.add('active-nav');
            } else if (currentDir === "~/projects" || activeFile === "README.txt") {
                document.getElementById('nav-btn-projects')?.classList.add('active-nav');
            } else if (currentDir === "~/contact" || activeFile === "contact_me.txt") {
                document.getElementById('nav-btn-contact')?.classList.add('active-nav');
            }

            // Build right-side folder hierarchy with small λ symbol on every line
            let html = '';
            const isRootActive = (currentDir === "~" && !activeFile) ? 'tree-active' : '';
            html += `<div class="tree-item tree-folder ${isRootActive}" onclick="treeClickDir('~')">λ ~/</div>`;

            const folders = [
                { dir: "~/about", name: "about/" },
                { dir: "~/resume", name: "resume/" },
                { dir: "~/projects", name: "projects/" },
                { dir: "~/contact", name: "contact/" }
            ];

            folders.forEach(f => {
                const isFolderSelected = (currentDir === f.dir && !activeFile) ? 'tree-active' : '';
                html += `<div class="tree-item tree-folder ${isFolderSelected}" onclick="treeClickDir('${f.dir}')">λ ├─ ${f.name}</div>`;

                if (currentDir === f.dir) {
                    const folderFiles = Object.keys(fileSystem[f.dir].files);
                    folderFiles.forEach((file, idx) => {
                        const branch = (idx === folderFiles.length - 1) ? '└─' : '├─';
                        const isActive = (activeFile === file) ? 'tree-active' : '';
                        html += `<div class="tree-item ${isActive}" onclick="treeClickFile('${f.dir}', '${file}')">λ │  ${branch} ${file}</div>`;
                    });
                }
            });

            navTreeEl.innerHTML = html;
        }

        function treeClickDir(targetDir) {
            if (!isLoggedIn || isAuthenticating || !isPoweredOn) return;
            if (editorOpen) closeEditor();
            quickCommand(`cd ${targetDir}`);
        }

        function treeClickFile(folderPath, fileName) {
            if (!isLoggedIn || isAuthenticating || !isPoweredOn) return;
            if (editorOpen) closeEditor();
            if (currentDir !== folderPath) {
                currentDir = folderPath;
            }
            quickCommand(`vim ${fileName}`);
        }

        // =========================================================================
        // TERMINAL OUTPUT HELPERS
        // =========================================================================
        function printLine(htmlContent, className = "") {
            const div = document.createElement('div');
            div.className = `line ${className}`.trim();
            div.innerHTML = htmlContent;
            outputEl.appendChild(div);
            terminalEl.scrollTop = terminalEl.scrollHeight;
            return div;
        }

        function printHelpBlock() {
            printLine("--- ePidOS Terminal Handheld Help ---");
            printLine("-   ls                List files in current directory");
            printLine("-   cd [dir]          Change directory (~, about, resume, projects, contact)");
            printLine("-   cat [file]        Print file content to terminal");
            printLine("-   vim / nano [file] Open file in interactive text editor");
            printLine("-   degauss           Demagnetize CRT display coil");
            printLine("-   pwd               Print working directory path");
            printLine("-   clear             Clear terminal display");
            printLine("----------------------------------------------------------------");
        }

        // =========================================================================
        // INITIAL BOOT & NEOFETCH OPERATOR LOGIN SEQUENCE
        // =========================================================================
        function initBootScreen() {
            playCrtPowerOnAnimation();
            outputEl.innerHTML = "";
            setLedStatus('offline');
            printLine("DERAILLEUR v2 // BIOS REV 4.09 (C) CHADWICK CORPS.");
            printLine("Checking 640K Low-Power CMOS RAM... OK");
            printLine("Mounting /dev/epidos0 on / ... READONLY");
            printLine("----------------------------------------------------------------");
            printLine("Enter operator handle to initialize session:");
            updateNavAndTree();
        }

        async function handleOperatorLogin(nameInput) {
            isAuthenticating = true;
            operatorName = (nameInput.trim() || "operator").toLowerCase().replace(/\s+/g, '_');
            avatarBoxEl.textContent = operatorName.charAt(0).toUpperCase();
            inputLineEl.style.display = "none";
            setLedStatus('thinking');

            const authLine = printLine("Authenticating operator credentials... /");
            printLine("----------------------------------------------------------------");
            const spinnerFrames = ["/", "-", "\\", "|"];
            let frameIdx = 0;
            const spinnerTimer = setInterval(() => {
                frameIdx = (frameIdx + 1) % spinnerFrames.length;
                authLine.textContent = `Authenticating operator credentials... ${spinnerFrames[frameIdx]}`;
            }, 120);

            // Fetch live operator location & weather cleanly with strict fallback
            let locationText = "Philadelphia, Pennsylvania";
            let weatherText = "58°F, Clear (Coffee Mode)";

            try {
                const controller = new AbortController();
                const timeoutId = setTimeout(() => controller.abort(), 1600);
                const geoRes = await fetch("https://ipapi.co/json/", { signal: controller.signal });
                clearTimeout(timeoutId);
                if (geoRes.ok) {
                    const geoData = await geoRes.json();
                    if (geoData.city && geoData.region) {
                        locationText = `${geoData.city}, ${geoData.region}`;
                    }
                }
            } catch (e) {
                // Keep default fallback
            }

            try {
                const controller2 = new AbortController();
                const timeoutId2 = setTimeout(() => controller2.abort(), 1600);
                const wttrRes = await fetch("https://wttr.in/?format=%t,+%C", { signal: controller2.signal });
                clearTimeout(timeoutId2);
                if (wttrRes.ok) {
                    const rawWeather = await wttrRes.text();
                    const cleaned = rawWeather
                        .replace(/<[^>]*>/g, '')
                        .replace(/[^\x20-\x7E°]/g, '')
                        .trim();
                    if (cleaned && cleaned.length < 42 && !cleaned.toLowerCase().includes("error") && !cleaned.toLowerCase().includes("html")) {
                        weatherText = `${cleaned} (Coffee Mode)`;
                    }
                }
            } catch (e) {
                // Keep default fallback
            }

            setTimeout(() => {
                clearInterval(spinnerTimer);
                authLine.textContent = "Authenticating operator credentials...";

                const nowStr = new Date().toLocaleString();

                // Empty line before operator block
                printLine("&nbsp;");
                printLine(`λ Operator: ${operatorName}`);
                printLine(`λ Host: Derailleur v2 Handheld`);
                printLine(`λ Time: ${nowStr}`);
                printLine(`λ Location: ${locationText}`);
                printLine(`λ Weather: ${weatherText}`);
                printLine(`λ Status: Online`);
                printLine("&nbsp;");
                printLine("----------------------------------------------------------------");
                printHelpBlock();

                isAuthenticating = false;
                isLoggedIn = true;
                setLedStatus('online');
                updatePromptLabel();
                inputLineEl.style.display = "flex";
                cmdInputEl.focus();
            }, 900);
        }

        function updatePromptLabel() {
            promptLabelEl.textContent = `${operatorName}@derailleur:${currentDir}$`;
            updateNavAndTree();
        }

        // =========================================================================
        // FILENAME RESOLVER (Handles about.txt / about-me.txt / about_me.txt)
        // =========================================================================
        function resolveFileName(inputName, dirObj) {
            if (!inputName) return null;
            const clean = inputName.trim();
            if (dirObj.files[clean]) return clean;

            const normalized = clean.toLowerCase().replace(/-/g, '_');
            const withTxt = normalized.endsWith('.txt') ? normalized : `${normalized}.txt`;
            if (dirObj.files[withTxt]) return withTxt;

            if (clean.toLowerCase().startsWith('about') && dirObj.files['about_me.txt']) return 'about_me.txt';
            if ((clean.toLowerCase().startsWith('contact') || clean.toLowerCase().startsWith('comm')) && dirObj.files['contact_me.txt']) return 'contact_me.txt';
            if (clean.toLowerCase().startsWith('readme') && dirObj.files['README.txt']) return 'README.txt';

            return null;
        }

        // =========================================================================
        // SIMULATED VIM / NANO TEXT EDITOR
        // =========================================================================
        function openEditor(appType, fileName, fileContent) {
            editorOpen = true;
            activeFile = fileName;
            updateNavAndTree();

            if (appType === 'nano') {
                editorAppTitleEl.textContent = "GNU nano 6.2 // Derailleur v2";
                editorStatusHint("Press ESC or Ctrl+X to exit");
            } else {
                editorAppTitleEl.textContent = "VIM - Vi IMproved 8.2 // Derailleur v2";
                editorStatusHint("Press ESC or type :q to exit");
            }

            editorTopFileEl.textContent = `File: ${fileName}`;
            editorBottomFileEl.textContent = `"${fileName}" [Readonly]`;
            editorContentEl.innerHTML = fileContent;

            editorViewEl.style.display = "flex";
            editorContentEl.scrollTop = 0;
        }

        function editorStatusHint(text) {
            editorViewEl.querySelector('#editor-status span:last-child').textContent = text;
        }

        function closeEditor() {
            editorOpen = false;
            activeFile = null;
            editorViewEl.style.display = "none";
            updateNavAndTree();
            cmdInputEl.focus();
        }

        // =========================================================================
        // COMMAND PARSER & EXECUTION
        // =========================================================================
        function executeSingleCommand(rawCmd) {
            const trimmed = rawCmd.trim();
            if (!trimmed) return;

            const parts = trimmed.split(/\s+/);
            const cmd = parts[0].toLowerCase();
            const arg = parts.slice(1).join(" ");

            const dirObj = fileSystem[currentDir];

            if (cmd === "help") {
                printHelpBlock();
                return;
            }

            if (cmd === "degauss") {
                triggerDegauss();
                printLine("[CRT COIL] :: Magnetic degaussing pulse discharged.");
                return;
            }

            if (cmd === "reboot" || cmd === "restart") {
                restartSystem();
                return;
            }

            if (cmd === "clear") {
                outputEl.innerHTML = "";
                activeFile = null;
                updateNavAndTree();
                return;
            }

            if (cmd === "pwd") {
                const fullPath = currentDir.replace("~", `/home/${operatorName}`);
                printLine(fullPath);
                return;
            }

            if (cmd === "ls") {
                let items = [];
                dirObj.folders.forEach(f => {
                    items.push(`<span class="ls-dir">${f}/</span>`);
                });
                Object.keys(dirObj.files).forEach(file => {
                    items.push(`<span class="ls-file">${file}</span>`);
                });
                printLine(items.join("    "));
                return;
            }

            if (cmd === "cd") {
                activeFile = null;
                const cleanArg = (arg || "~").replace(/\/+$/, "");
                if (!cleanArg || cleanArg === "~" || cleanArg === "/" || cleanArg === "..") {
                    if (currentDir !== "~") pulseHardwareButton('btn-rew');
                    currentDir = "~";
                    updatePromptLabel();
                } else {
                    const folderKey = cleanArg.startsWith("~/") ? cleanArg : `~/${cleanArg.replace(/^\.\//, "")}`;
                    if (fileSystem[folderKey]) {
                        pulseHardwareButton('btn-ffwd');
                        currentDir = folderKey;
                        updatePromptLabel();
                    } else {
                        printLine(`bash: cd: ${arg}: No such directory`);
                    }
                }
                return;
            }

            if (cmd === "cat") {
                if (!arg) {
                    printLine("usage: cat [filename]");
                    return;
                }
                let targetDirObj = dirObj;
                let fileQuery = arg;

                // Allow cross-folder paths or root shortcuts
                if (arg.includes("/")) {
                    const segs = arg.split("/");
                    fileQuery = segs.pop();
                    const folderName = segs.pop();
                    if (fileSystem[`~/${folderName}`]) {
                        targetDirObj = fileSystem[`~/${folderName}`];
                    }
                }

                const resolved = resolveFileName(fileQuery, targetDirObj);
                if (resolved) {
                    pulseHardwareButton('btn-play');
                    activeFile = resolved;
                    updateNavAndTree();
                    printLine(targetDirObj.files[resolved]);
                } else {
                    printLine(`cat: ${arg}: No such file in ${currentDir}`);
                }
                return;
            }

            if (cmd === "vim" || cmd === "vi" || cmd === "nano") {
                if (!arg) {
                    printLine(`usage: ${cmd} [filename]`);
                    return;
                }
                let targetDirObj = dirObj;
                let fileQuery = arg;

                if (arg.includes("/")) {
                    const segs = arg.split("/");
                    fileQuery = segs.pop();
                    const folderName = segs.pop();
                    if (fileSystem[`~/${folderName}`]) {
                        currentDir = `~/${folderName}`;
                        targetDirObj = fileSystem[currentDir];
                        updatePromptLabel();
                    }
                }

                const resolved = resolveFileName(fileQuery, targetDirObj);
                if (resolved) {
                    pulseHardwareButton('btn-play');
                    openEditor(cmd === "nano" ? "nano" : "vim", resolved, targetDirObj.files[resolved]);
                } else {
                    printLine(`${cmd}: ${arg}: No such file in ${currentDir}`);
                }
                return;
            }

            printLine(`bash: ${cmd}: command not found (type 'help' for commands)`);
        }

        function handleCommandLine(fullInput) {
            printLine(`${promptLabelEl.textContent} ${fullInput}`);
            const chainedCommands = fullInput.split("&&");
            chainedCommands.forEach(c => executeSingleCommand(c));
        }

        function quickCommand(cmdString) {
            if (!isLoggedIn || isAuthenticating || !isPoweredOn) return;
            if (editorOpen) closeEditor();
            handleCommandLine(cmdString);
        }

        // =========================================================================
        // KEYBOARD & FOCUS LISTENERS
        // =========================================================================
        cmdInputEl.addEventListener('keydown', (e) => {
            if (!isPoweredOn) return;
            if (e.key === 'Enter') {
                const val = cmdInputEl.value;
                cmdInputEl.value = '';

                if (!isLoggedIn && !isAuthenticating) {
                    printLine(`login as: ${val || 'operator'}`);
                    handleOperatorLogin(val);
                    return;
                }

                if (isLoggedIn && !isAuthenticating) {
                    handleCommandLine(val);
                }
            }
        });

        window.addEventListener('keydown', (e) => {
            if (!isPoweredOn) return;
            if (editorOpen) {
                if (e.key === 'Escape' || e.key === 'q' || (e.ctrlKey && e.key.toLowerCase() === 'x')) {
                    e.preventDefault();
                    closeEditor();
                }
            }
        });

        function focusTerminalInput(e) {
            if (!isPoweredOn) return;
            if (e.target.tagName === 'A' || e.target.tagName === 'BUTTON') return;
            if (!editorOpen && !isAuthenticating) {
                cmdInputEl.focus();
            }
        }

        // Start Boot Prompt on Load
        window.onload = () => {
            initBootScreen();
            cmdInputEl.focus();
        };
    </script>
</body>
</html>