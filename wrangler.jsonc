{
  "name": "derailleur-epidos",
  "main": "worker.ts",
  "compatibility_date": "2025-02-14",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "kv_namespaces": [
    {
      "binding": "EPIDOS_KV",
      "id": "5f2ec74a5419450da6020f645a79d40f"
    }
  ],
  "observability": {
    "enabled": true
  }
}
