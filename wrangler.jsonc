{
  "name": "derailleur-epidos",
  "main": "worker.ts",
  "compatibility_date": "2025-02-14",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "observability": {
    "enabled": true
  }
}
